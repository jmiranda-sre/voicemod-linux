[Desktop Entry]
Type=Application
Version=1.5
Name=Voicemod Linux
GenericName=Voice changer
Comment=Native clean-room voice changer: real-time effects, soundboard and virtual microphone (PipeWire)
Exec=vm-ui %U
Icon=io.github.voicemodlinux.vm
Terminal=false
Categories=AudioVideo;Audio;Mixer;
Keywords=voice;changer;microphone;pitch;effects;soundboard;pipewire;
StartupNotify=true
# X11 groups the window by WM_CLASS (the binary name). On Wayland the window
# sets app_id=io.github.voicemodlinux.vm (this file's ID), which is what
# compositors pair with this entry to find the icon.
StartupWMClass=vm-ui
SingleMainWindow=true
Actions=StartMinimized;

[Desktop Action StartMinimized]
Name=Start minimized
Exec=vm-ui --minimized
