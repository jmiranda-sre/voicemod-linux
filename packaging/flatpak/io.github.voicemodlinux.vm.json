{
  "id": "io.github.voicemodlinux.vm",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "vm-ui",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm22"
  ],
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--share=ipc",
    "--share=network"
  ],
  "modules": [
    {
      "name": "voicemod-linux",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/voicemod-linux/cargo",
          "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
          "CARGO_NET_GIT_FETCH_WITH_CLI": "true"
        }
      },
      "build-commands": [
        "bash packaging/flatpak/build-inside.sh"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/jmiranda-sre/voicemod-linux.git",
          "tag": "v0.4.0",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/jmiranda-sre/voicemod-linux/releases/latest",
            "tag-attr": "tag_name",
            "version-attr": "tag_name"
          }
        }
      ]
    }
  ]
}
